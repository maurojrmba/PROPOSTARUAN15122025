# Token do bot — obtido via @BotFather no Telegram
TELEGRAM_BOT_TOKEN=seu_token_aqui

# Seu ID numérico no Telegram — obtido via @userinfobot
ADMIN_CHAT_ID=seu_id_aqui

# Chave da API da Anthropic (Claude) — https://console.anthropic.com
ANTHROPIC_API_KEY=sua_chave_aqui

# ID da planilha Google Sheets (opcional — aparece na URL da planilha)
GOOGLE_SHEET_ID=id_da_planilha_aqui
