# Token do bot — obtido via @BotFather no Telegram
TELEGRAM_BOT_TOKEN=seu_token_aqui

# Seu ID numérico no Telegram (admin que recebe os relatórios)
ADMIN_CHAT_ID=6572198956

# Chave da API da Anthropic (Claude Vision) — https://console.anthropic.com
ANTHROPIC_API_KEY=sua_chave_aqui

# ── Gmail ──────────────────────────────────────────────
# Conta Gmail que VAI ENVIAR os e-mails
GMAIL_USER=seu_email@gmail.com

# Senha de App do Gmail (não é a senha normal!)
# Para gerar: Google Account > Segurança > Verificação em 2 etapas > Senhas de app
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# E-mail que VAI RECEBER os relatórios (pode ser o mesmo)
EMAIL_DESTINATARIO=seu_email@gmail.com

# ── Google Sheets (opcional) ────────────────────────────
# ID da planilha Google Sheets (aparece na URL da planilha)
GOOGLE_SHEET_ID=id_da_planilha_aqui
